# ─────────────────────────────────────────────────────────────────────────────
# SYSTEM IRL environment. Copy to .env.local. Every variable is optional:
# with none set, the app runs the local demo backend (PGlite + signed cookies).
# Never commit real values. Server-only secrets must NOT use the NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (all three enable hosted Postgres + Supabase Auth with RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only: used for validated XP/unlock writes

# AI System Guide (optional; without it a deterministic guide is used)
ANTHROPIC_API_KEY=                  # server-only
AI_MODEL=claude-opus-5-5

# Local demo backend
LOCAL_DB_DIR=.data/pglite           # PGlite data directory (persisted PostgreSQL)
SESSION_SECRET=                     # ≥ 32 chars; auto-generated into .data/ if unset
# INSECURE_COOKIES=1                # only for plain-HTTP non-localhost demos
